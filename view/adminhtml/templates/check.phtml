<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\View\Element\Template;
use Magento\Framework\Escaper;
use LokiCheckout\CoreAdminhtml\ViewModel\SystemCheckCollection;
use Loki\Components\Factory\ViewModelFactory;

/** @version 1.0.10 */
/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelFactory $viewModelFactory */
/** @var SystemCheckCollection $systemCheckCollection */
/** @var CssClass $css */

$systemCheckCollection = $viewModelFactory->create(SystemCheckCollection::class);
?>

<div class="<?= $escaper->escapeHtml($css('loki-system-check admin__data-grid-wrap')) ?>">
    <table class="<?= $escaper->escapeHtml($css('data-grid', 'table')) ?>">
        <thead>
        <tr>
            <th class="<?= $escaper->escapeHtml($css('data-grid-th', 'th')) ?>">
                <span class="<?= $escaper->escapeHtml($css('data-grid-cell-content', 'th-span')) ?>">
                    <?= $escaper->escapeHtml(__('System Check')) ?>
                </span>
            </th>
            <th class="<?= $escaper->escapeHtml($css('data-grid-th', 'th')) ?>">
                <span class="<?= $escaper->escapeHtml($css('data-grid-cell-content', 'th-span')) ?>">
                    <?= $escaper->escapeHtml(__('Value')) ?>
                </span>
            </th>
            <th class="<?= $escaper->escapeHtml($css('data-grid-th', 'th')) ?>">
                <span class="<?= $escaper->escapeHtml($css('data-grid-cell-content', 'th-span')) ?>">
                    <?= $escaper->escapeHtml(__('Recommendation')) ?>
                </span>
            </th>
        </tr>
        </thead>
        <tbody>
        <?php foreach ($systemCheckCollection->getSystemChecks() as $systemCheck): ?>
            <?php foreach ($systemCheck->getCheckResultCollection()->get() as $checkResult): ?>
                <?php $valueClassSuffix = $checkResult->isValid() ? 'notice' : 'error'; ?>
                <tr>
                    <td>
                        <div class="<?= $escaper->escapeHtml($css('data-grid-cell-content', 'label')) ?>">
                            <?php if ($checkResult->getUrl()): ?>
                            <a href="<?= $escaper->escapeUrl($checkResult->getUrl()) ?>">
                            <?php endif; ?>
                            <?= $escaper->escapeHtml($checkResult->getLabel()) ?>
                            <?php if ($checkResult->getUrl()): ?>
                            </a>
                            <?php endif; ?>
                        </div>
                    </td>
                    <td>
                        <div class="<?= $escaper->escapeHtml($css('data-grid-cell-content system-check', 'value')) ?> system-check-<?= $escaper->escapeHtml($valueClassSuffix) ?>">
                            <?= $escaper->escapeHtml($checkResult->getValue()) ?>
                        </div>
                    </td>
                    <td>
                        <div class="<?= $escaper->escapeHtml($css('data-grid-cell-content', 'recommendation')) ?>">
                            <?= $escaper->escapeHtml($checkResult->getRecommendation()) ?>
                        </div>
                    </td>
                </tr>
            <?php endforeach; ?>
        <?php endforeach; ?>
        </tbody>
    </table>
</div>

<style>
    .system-check {
        padding: 1px 3px 1px 3px;
    }

    .system-check-error {
        border: 1px solid #e22626;
        background: #f9d4d4;
        color: #e22626;
    }

    .system-check-warning {
        border: 1px solid #ff8538;
        background: #ffe3cd;
        color: #ff833b;
    }

    .system-check-notice {
        border: 1px solid #5b8116;
        background: #d0e5a9;
        color: #185b00;
    }
</style>

