<?php
declare(strict_types=1);

/** @version 1.0.6 */

use Magento\Framework\View\Element\Template;
use Magento\Framework\Escaper;
use LokiCheckout\CoreAdminhtml\ViewModel\SystemCheckCollection;
use Loki\Components\Factory\ViewModelFactory;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelFactory $viewModelFactory */
/** @var SystemCheckCollection $systemCheckCollection */
$systemCheckCollection = $viewModelFactory->create(SystemCheckCollection::class);
?>

<div class="<?= $css('admin__data-grid-wrap', '@todo') ?>">
    <table class="<?= $css('data-grid', '@todo') ?>">
        <thead>
        <tr>
            <th class="<?= $css('data-grid-th', '@todo') ?>">
                <span class="<?= $css('data-grid-cell-content', '@todo') ?>">
                    System Check
                </span>
            </th>
            <th class="<?= $css('data-grid-th', '@todo') ?>">
                <span class="<?= $css('data-grid-cell-content', '@todo') ?>">
                    Value
                </span>
            </th>
            <th class="<?= $css('data-grid-th', '@todo') ?>">
                <span class="<?= $css('data-grid-cell-content', '@todo') ?>">
                    Recommendation
                </span>
            </th>
        </tr>
        </thead>
        <tbody>
        <?php foreach ($systemCheckCollection->getSystemChecks() as $systemCheck): ?>
            <?php foreach ($systemCheck->getCheckResultCollection()->get() as $checkResult): ?>
                <?php $valueClassSuffix = $checkResult->isValid() ? 'notice' : 'error'; ?>
                <tr>
                    <td>
                        <div class="<?= $css('data-grid-cell-content', '@todo') ?>">
                            <?= $escaper->escapeHtml($checkResult->getLabel()) ?>
                        </div>
                    </td>
                    <td>
                        <div class="data-grid-cell-content system-check system-check-<?= $escaper->escapeHtml($valueClassSuffix) ?>">
                            <?= $escaper->escapeHtml($checkResult->getValue()) ?>
                        </div>
                    </td>
                    <td>
                        <div class="<?= $css('data-grid-cell-content', '@todo') ?>">
                            <?= $escaper->escapeHtml($checkResult->getRecommendation()) ?>
                        </div>
                    </td>
                </tr>
            <?php endforeach; ?>
        <?php endforeach; ?>
        </tbody>
    </table>
</div>

<style>
    .system-check {
        padding: 1px 3px 1px 3px;
    }

    .system-check-error {
        border: 1px solid #e22626;
        background: #f9d4d4;
        color: #e22626;
    }

    .system-check-warning {
        border: 1px solid #ff8538;
        background: #ffe3cd;
        color: #ff833b;
    }

    .system-check-notice {
        border: 1px solid #5b8116;
        background: #d0e5a9;
        color: #185b00;
    }
</style>

