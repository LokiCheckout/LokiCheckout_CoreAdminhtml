<?php
declare(strict_types=1);

/** @version 1.0.15 */

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\View\Element\Template;
use Magento\Framework\Escaper;
use Loki\Components\Factory\ViewModelFactory;
use LokiCheckout\CoreAdminhtml\ViewModel\Modules;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelFactory $viewModelFactory */
/** @var Modules $modulesViewModel */
/** @var CssClass $css */
$modulesViewModel = $viewModelFactory->create(Modules::class);
$modules = $modulesViewModel->getModules();
$showRegistered = $modulesViewModel->showRegistered();
$majorVersionMismatchModules = $modulesViewModel->getMajorVersionMismatchModules($modules);
$majorVersionUpdates = $modulesViewModel->getMajorVersionUpdates();
?>
<?php if (!empty($majorVersionUpdates)): ?>
    <div class="<?= $escaper->escapeHtml($css('message message-warning', 'major-version-updates')) ?>">
        <?= $escaper->escapeHtml(__('The following packages have a new major version available:')) ?>
        <ul>
            <?php foreach ($majorVersionUpdates as $majorVersionUpdate): ?>
                <li><?= $escaper->escapeHtml($majorVersionUpdate->getComposerName() . ': ' . $majorVersionUpdate->getInstalledVersion() . ' → ' . $majorVersionUpdate->getLatestVersion()) ?></li>
            <?php endforeach; ?>
        </ul>
    </div>
<?php endif; ?>
<?php if (!empty($majorVersionMismatchModules)): ?>
    <div class="<?= $escaper->escapeHtml($css('message message-warning', 'major-version-warning')) ?>">
        <?= $escaper->escapeHtml(__(
            '%1 module(s) have a different major version than the latest available version: %2. Check the upgrade notes before upgrading.',
            count($majorVersionMismatchModules),
            implode(', ', array_map(fn ($module) => $module->getName(), $majorVersionMismatchModules))
        )) ?>
    </div>
<?php endif; ?>
<div class="<?= $escaper->escapeHtml($css('admin__data-grid-header admin__data-grid-toolbar', 'toolbar')) ?>">
    <div class="<?= $escaper->escapeHtml($css('admin__data-grid-header-row', 'header-row')) ?>"></div>
    <div class="<?= $escaper->escapeHtml($css('admin__data-grid-header-row', 'header-row')) ?>"><?= $escaper->escapeHtml(__ ('%1 modules found', count($modules))) ?></div>
</div>

<div class="<?= $escaper->escapeHtml($css('admin__data-grid-wrap', 'grid')) ?>">
    <table class="<?= $escaper->escapeHtml($css('data-grid', 'table')) ?>">
        <thead>
        <tr>
            <th class="<?= $escaper->escapeHtml($css('data-grid-th', 'th')) ?>">
                <span class="<?= $escaper->escapeHtml($css('data-grid-cell-content', 'th-span')) ?>">
                    <?= $escaper->escapeHtml(__('Module name')) ?>
                </span>
            </th>
            <th class="<?= $escaper->escapeHtml($css('data-grid-th', 'th')) ?>">
                <span class="<?= $escaper->escapeHtml($css('data-grid-cell-content', 'th-span')) ?>">
                    <?= $escaper->escapeHtml(__('Module status')) ?>
                </span>
            </th>
            <?php if ($showRegistered): ?>
            <th class="<?= $escaper->escapeHtml($css('data-grid-th', 'th')) ?>">
                <span class="<?= $escaper->escapeHtml($css('data-grid-cell-content', 'th-span')) ?>" title="Optional DI hook for various tasks">
                    <?= $escaper->escapeHtml(__('LokiCheckout registered')) ?>
                </span>
            </th>
            <?php endif; ?>
            <th class="<?= $escaper->escapeHtml($css('data-grid-th', 'th')) ?>">
                <span class="<?= $escaper->escapeHtml($css('data-grid-cell-content', 'th-span')) ?>">
                    <?= $escaper->escapeHtml(__('Composer name')) ?>
                </span>
            </th>
            <th class="<?= $escaper->escapeHtml($css('data-grid-th', 'th')) ?>">
                <span class="<?= $escaper->escapeHtml($css('data-grid-cell-content', 'th-span')) ?>" title="Current version locked in your root composer.lock">
                    <?= $escaper->escapeHtml(__('Current version')) ?>
                </span>
            </th>
            <th class="<?= $escaper->escapeHtml($css('data-grid-th', 'th')) ?>">
                <span class="<?= $escaper->escapeHtml($css('data-grid-cell-content', 'th-span')) ?>" title="Latest version as read from https://composer.yireo.com/">
                    <?= $escaper->escapeHtml(__('Newest version')) ?>
                </span>
            </th>
        </tr>
        </thead>
        <tbody>
        <?php foreach ($modules as $module): ?>
            <tr>
                <td>
                    <div class="<?= $escaper->escapeHtml($css('data-grid-cell-content', 'grid-cell')) ?>">
                        <a target="_blank" rel="noopener noreferrer" href="<?= $escaper->escapeUrl('https://loki-checkout.com/docs/04-modules/' . $module->getName()) ?>">
                            <?= $escaper->escapeHtml($module->getName()) ?>
                        </a>
                    </div>
                </td>
                <td>
                    <div class="<?= $escaper->escapeHtml($css('data-grid-cell-content', 'grid-cell')) ?>">
                        <?php if ($module->isEnabled()): ?>
                            <span class="<?= $escaper->escapeHtml($css('module-status module-status-notice', 'status-notice')) ?>"><?= $escaper->escapeHtml(__('Enabled')) ?></span>
                        <?php else: ?>
                            <span class="<?= $escaper->escapeHtml($css('module-status module-status-error', 'status-warning')) ?>"><?= $escaper->escapeHtml(__('Disabled')) ?></span>
                        <?php endif; ?>
                    </div>
                </td>
                <?php if ($showRegistered): ?>
                <td>
                    <div class="<?= $escaper->escapeHtml($css('data-grid-cell-content', 'grid-cell')) ?>">
                        <?php if ($module->isLokiCheckoutRegistered()): ?>
                            <span class="<?= $escaper->escapeHtml($css('module-status module-status-notice', 'status-notice')) ?>"><?= $escaper->escapeHtml(__('Yes')) ?></span>
                        <?php else: ?>
                            <span class="<?= $escaper->escapeHtml($css('module-status module-status-warning', 'status-warning')) ?>"><?= $escaper->escapeHtml(__('No')) ?></span>
                        <?php endif; ?>
                    </div>
                </td>
                <?php endif; ?>
                <td>
                    <div class="<?= $escaper->escapeHtml($css('data-grid-cell-content', 'grid-cell')) ?>">
                        <code><?= $escaper->escapeHtml($module->getComposerName()) ?></code>
                    </div>
                </td>
                <td>
                    <div class="<?= $escaper->escapeHtml($css('data-grid-cell-content', 'grid-cell')) ?>">
                        <code title="<?= $escaper->escapeHtml($module->getDate()) ?>">
                            <?php if ($module->isDevVersion()): ?>
                                <?= $escaper->escapeHtml($modulesViewModel->getGitText($module->getGitInfo())) ?>
                            <?php else: ?>
                                <?= $escaper->escapeHtml($module->getComposerVersion()) ?>
                            <?php endif; ?>
                        </code>
                    </div>
                </td>
                <td>
                    <div class="<?= $escaper->escapeHtml($css('data-grid-cell-content', 'grid-cell')) ?>">
                        <?php $cssClass = $modulesViewModel->getLatestModuleVersionClass($module); ?>
                        <span class="module-status module-status-<?= $escaper->escapeHtml($cssClass) ?>" title="<?= $escaper->escapeHtml($module->getLatestModuleDate()) ?>">
                            <?= $escaper->escapeHtml($modulesViewModel->getLatestModuleVersion($module)) ?>
                        </span>
                        <?php if ($modulesViewModel->hasMajorVersionMismatch($module)): ?>
                            <div class="<?= $escaper->escapeHtml($css('module-major-warning', 'major-warning')) ?>">
                                <?= $escaper->escapeHtml(__(
                                    'Major version differs from latest (%1 → %2), check the upgrade notes',
                                    $module->getComposerVersion(),
                                    $module->getLatestComposerVersion()
                                )) ?>
                            </div>
                        <?php endif; ?>
                    </div>
                </td>
            </tr>
        <?php endforeach; ?>
        </tbody>
    </table>
</div>

<style>
    .module-status {
        padding: 1px 3px 1px 3px;
    }

    .module-major-warning {
        margin-top: 4px;
        color: #ff833b;
        font-size: 1.2rem;
    }

    .module-status-error {
        border: 1px solid #e22626;
        background: #f9d4d4;
        color: #e22626;
    }

    .module-status-warning {
        border: 1px solid #ff8538;
        background: #ffe3cd;
        color: #ff833b;
    }

    .module-status-notice {
        border: 1px solid #5b8116;
        background: #d0e5a9;
        color: #185b00;
    }
</style>
