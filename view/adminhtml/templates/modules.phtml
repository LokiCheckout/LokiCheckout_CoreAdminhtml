<?php
declare(strict_types=1);

/** @version 1.0.4 */

use Loki\Components\Factory\ViewModelFactory;
use LokiCheckout\CoreAdminhtml\ViewModel\Modules;

/** @var ViewModelFactory $viewModelFactory */
/** @var Modules $modulesViewModel */
$modulesViewModel = $viewModelFactory->create(Modules::class);
$modules = $modulesViewModel->getModules();
$showRegistered = $modulesViewModel->showRegistered();
?>
<div class="admin__data-grid-header admin__data-grid-toolbar">
    <div class="admin__data-grid-header-row"></div>
    <div class="admin__data-grid-header-row"><?= $escaper->escapeHtml(__ ('%1 modules found', count($modules))) ?></div>
</div>

<div class="admin__data-grid-wrap">
    <table class="data-grid">
        <thead>
        <tr>
            <th class="data-grid-th">
                <span class="data-grid-cell-content">
                    <?= $escaper->escapeHtml(__('Module name')) ?>
                </span>
            </th>
            <th class="data-grid-th">
                <span class="data-grid-cell-content">
                    <?= $escaper->escapeHtml(__('Module status')) ?>
                </span>
            </th>
            <?php if ($showRegistered): ?>
            <th class="data-grid-th">
                <span class="data-grid-cell-content" title="Optional DI hook for various tasks">
                    <?= $escaper->escapeHtml(__('LokiCheckout registered')) ?>
                </span>
            </th>
            <?php endif; ?>
            <th class="data-grid-th">
                <span class="data-grid-cell-content">
                    <?= $escaper->escapeHtml(__('Composer name')) ?>
                </span>
            </th>
            <th class="data-grid-th">
                <span class="data-grid-cell-content" title="Current version locked in your root composer.lock">
                    <?= $escaper->escapeHtml(__('Current version')) ?>
                </span>
            </th>
            <th class="data-grid-th">
                <span class="data-grid-cell-content" title="Latest version as read from https://composer.yireo.com/">
                    <?= $escaper->escapeHtml(__('Newest version')) ?>
                </span>
            </th>
        </tr>
        </thead>
        <tbody>
        <?php foreach ($modules as $module): ?>
            <tr>
                <td>
                    <div class="data-grid-cell-content">
                        <a target="_new" href="https://loki-checkout.com/docs/04-modules/<?= $escaper->escapeHtml($module->getName()) ?>">
                            <?= $escaper->escapeHtml($module->getName()) ?>
                        </a>
                    </div>
                </td>
                <td>
                    <div class="data-grid-cell-content">
                        <?php if ($module->isEnabled()): ?>
                            <span class="module-status module-status-notice"><?= $escaper->escapeHtml(__('Enabled')) ?></span>
                        <?php else: ?>
                            <span class="module-status module-status-error"><?= $escaper->escapeHtml(__('Disabled')) ?></span>
                        <?php endif; ?>
                    </div>
                </td>
                <?php if ($showRegistered): ?>
                <td>
                    <div class="data-grid-cell-content">
                        <?php if ($module->isLokiCheckoutRegistered()): ?>
                            <span class="module-status module-status-notice"><?= $escaper->escapeHtml(__('Yes')) ?></span>
                        <?php else: ?>
                            <span class="module-status module-status-warning"><?= $escaper->escapeHtml(__('No')) ?></span>
                        <?php endif; ?>
                    </div>
                </td>
                <?php endif; ?>
                <td>
                    <div class="data-grid-cell-content">
                        <code><?= $escaper->escapeHtml($module->getComposerName()) ?></code>
                    </div>
                </td>
                <td>
                    <div class="data-grid-cell-content">
                        <code title="<?= $escaper->escapeHtml($module->getDate()) ?>">
                            <?php if ($module->isDevVersion()): ?>
                                <?= $escaper->escapeHtml($modulesViewModel->shortenGitCommit($module->getGitInfo()->getCommit())) ?>
                            <?php else: ?>
                                <?= $escaper->escapeHtml($module->getComposerVersion()) ?>
                            <?php endif; ?>
                        </code>
                    </div>
                </td>
                <td>
                    <div class="data-grid-cell-content">
                        <?php $cssClass = $modulesViewModel->getLatestModuleVersionClass($module); ?>
                        <span class="module-status module-status-<?= $escaper->escapeHtml($cssClass) ?>" title="<?= $escaper->escapeHtml($module->getLatestModuleDate()) ?>">
                            <?= $escaper->escapeHtml($modulesViewModel->getLatestModuleVersion($module)) ?>
                        </span>
                    </div>
                </td>
            </tr>
        <?php endforeach; ?>
        </tbody>
    </table>
</div>

<style>
    .module-status {
        padding: 1px 3px 1px 3px;
    }

    .module-status-error {
        border: 1px solid #e22626;
        background: #f9d4d4;
        color: #e22626;
    }

    .module-status-warning {
        border: 1px solid #ff8538;
        background: #ffe3cd;
        color: #ff833b;
    }

    .module-status-notice {
        border: 1px solid #5b8116;
        background: #d0e5a9;
        color: #185b00;
    }
</style>
