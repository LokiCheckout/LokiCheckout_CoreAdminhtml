<?php
declare(strict_types=1);

use Loki\Components\Factory\ViewModelFactory;
use LokiCheckout\CoreAdminhtml\ViewModel\Modules;

/** @var ViewModelFactory $viewModelFactory */
/** @var Modules $modulesViewModel */
$modulesViewModel = $viewModelFactory->create(Modules::class);
$modules = $modulesViewModel->getModules();
$showRegistered = $modulesViewModel->showRegistered();
?>
<div class="admin__data-grid-header admin__data-grid-toolbar">
    <div class="admin__data-grid-header-row"></div>
    <div class="admin__data-grid-header-row"><?= __ ('%1 modules found', count($modules)) ?></div>
</div>

<div class="admin__data-grid-wrap">
    <table class="data-grid">
        <thead>
        <tr>
            <th class="data-grid-th">
                <span class="data-grid-cell-content">
                    <?= __('Module name') ?>
                </span>
            </th>
            <th class="data-grid-th">
                <span class="data-grid-cell-content">
                    <?= __('Module status') ?>
                </span>
            </th>
            <?php if ($showRegistered): ?>
            <th class="data-grid-th">
                <span class="data-grid-cell-content" title="Optional DI hook for various tasks">
                    <?= __('LokiCheckout registered') ?>
                </span>
            </th>
            <?php endif; ?>
            <th class="data-grid-th">
                <span class="data-grid-cell-content">
                    <?= __('Composer name') ?>
                </span>
            </th>
            <th class="data-grid-th">
                <span class="data-grid-cell-content" title="Current version locked in your root composer.lock">
                    <?= __('Current version') ?>
                </span>
            </th>
            <th class="data-grid-th">
                <span class="data-grid-cell-content" title="Latest version as read from https://composer.yireo.com/">
                    <?= __('Newest version') ?>
                </span>
            </th>
        </tr>
        </thead>
        <tbody>
        <?php foreach ($modules as $module): ?>
            <tr>
                <td>
                    <div class="data-grid-cell-content">
                        <a target="_new" href="https://loki-checkout.com/docs/04-modules/<?= $module->getName() ?>">
                            <?= $module->getName() ?>
                        </a>
                    </div>
                </td>
                <td>
                    <div class="data-grid-cell-content">
                        <?php if ($module->isEnabled()): ?>
                            <span class="module-status module-status-notice"><?= __('Enabled') ?></span>
                        <?php else: ?>
                            <span class="module-status module-status-error"><?= __('Disabled') ?></span>
                        <?php endif; ?>
                    </div>
                </td>
                <?php if ($showRegistered): ?>
                <td>
                    <div class="data-grid-cell-content">
                        <?php if ($module->isLokiCheckoutRegistered()): ?>
                            <span class="module-status module-status-notice"><?= __('Yes') ?></span>
                        <?php else: ?>
                            <span class="module-status module-status-warning"><?= __('No') ?></span>
                        <?php endif; ?>
                    </div>
                </td>
                <?php endif; ?>
                <td>
                    <div class="data-grid-cell-content">
                        <code><?= $module->getComposerName() ?></code>
                    </div>
                </td>
                <td>
                    <div class="data-grid-cell-content">
                        <code title="<?= $module->getDate() ?>">
                            <?php if ($module->isDevVersion()): ?>
                                <?= $modulesViewModel->shortenGitCommit($module->getGitInfo()->getCommit()) ?>
                            <?php else: ?>
                                <?= $module->getComposerVersion() ?>
                            <?php endif; ?>
                        </code>
                    </div>
                </td>
                <td>
                    <div class="data-grid-cell-content">
                        <?php $cssClass = $modulesViewModel->getLatestModuleVersionClass($module); ?>
                        <span class="module-status module-status-<?= $cssClass ?>" title="<?= $module->getLatestModuleDate() ?>">
                            <?= $modulesViewModel->getLatestModuleVersion($module) ?>
                        </span>
                    </div>
                </td>
            </tr>
        <?php endforeach; ?>
        </tbody>
    </table>
</div>

<style>
    .module-status {
        padding: 1px 3px 1px 3px;
    }

    .module-status-error {
        border: 1px solid #e22626;
        background: #f9d4d4;
        color: #e22626;
    }

    .module-status-warning {
        border: 1px solid #ff8538;
        background: #ffe3cd;
        color: #ff833b;
    }

    .module-status-notice {
        border: 1px solid #5b8116;
        background: #d0e5a9;
        color: #185b00;
    }
</style>
