{
    "name": "loki-checkout/magento2-core-adminhtml",
    "version": "1.0.12",
    "description": "Magento Admin Panel module with a check page and latest modules",
    "type": "magento2-module",
    "require": {
        "ext-pcre": "*",
        "loki-checkout/magento2-core": "^2.0",
        "loki/magento2-components": "^2.0",
        "loki/magento2-css-utils": "^1.0",
        "magento/framework": "^103.0",
        "magento/module-backend": "^102.0",
        "magento/module-config": "^101.2",
        "php": ">=8.2 <8.6"
    },
    "license": [
        "OSL-3.0"
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "LokiCheckout\\CoreAdminhtml\\": ""
        }
    },
    "keywords": [
        "loki-checkout",
        "loki-checkout-plan-trial",
        "loki-checkout-category-core"
    ],
    "require-dev": {
        "yireo/magento2-integration-test-helper": "~0.0",
        "loki/magento2-functional-tests": "@dev",
        "loki-checkout/magento2-functional-tests": "@dev"
    }
}